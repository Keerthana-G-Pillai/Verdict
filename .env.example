# ============================================================
# VERDICT — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.
# ============================================================

# ── AI Providers ─────────────────────────────────────────────
# Provider priority: groq → openrouter → deterministic fallback
# Set AI_PROVIDER to force a specific provider (optional).
# Options: "groq" | "openrouter" | "fallback" | (empty = auto)
AI_PROVIDER=

# Groq — Free tier, primary AI provider
# Sign up at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter — Automatic fallback when Groq fails
# Sign up at: https://openrouter.ai/keys
# Recommended free model: meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# IBM watsonx — Optional premium provider
# Sign up at: https://dataplatform.cloud.ibm.com/
# WATSONX_API_KEY=
# WATSONX_PROJECT_ID=
# WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Supabase — Authentication & Database ─────────────────────
# Create a project at: https://supabase.com
# Settings → API → Project URL and anon public key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# IMPORTANT: Never expose the service role key to the client
# Only needed for server-side admin operations (not used in VERDICT)
# SUPABASE_SERVICE_ROLE_KEY=
